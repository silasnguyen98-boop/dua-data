# Admin credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://duadatav2-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase App Check / captcha
# Lưu ý: cả 2 biến dưới đây phải đúng thì backend mới ép captcha.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your_app_check_site_key
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=v3
FIREBASE_APP_CHECK_PROJECT_NUMBER=your_firebase_project_number

# PostgreSQL
POSTGRES_DB=duadata
POSTGRES_USER=duadata
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://duadata:your_postgres_password@localhost:5432/duadata

# NextAuth / Google OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP for registration confirmation email
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=noreply@duadata.net
SMTP_PASS=your_smtp_password
SMTP_FROM="Dứa Data <noreply@duadata.net>"
